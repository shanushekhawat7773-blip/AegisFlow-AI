# ==============================================================================
# AegisFlow AI - Environment Configuration
# Predict. Investigate. Simulate. Act.
# ==============================================================================

# Application Environment: "demo", "staging", "production"
AEGISFLOW_ENV=demo

# AI Provider: "deterministic" (zero-dependency offline mode) or "bedrock" (AWS Amazon Bedrock)
AI_PROVIDER=deterministic

# AWS Cloud Settings (Required if AI_PROVIDER=bedrock or deploying to AWS ECS/Lambda)
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Anomaly Detection Parameters
ANOMALY_ZSCORE_THRESHOLD=2.5
EWMA_ALPHA=0.3

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
